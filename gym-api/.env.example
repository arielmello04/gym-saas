# ─── Banco de dados ──────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/gymsystem
DB_USERNAME=gymsystem
DB_PASSWORD=gymsystem

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=troque-por-uma-string-aleatoria-de-no-minimo-32-chars

# ─── App ─────────────────────────────────────────────────────
APP_BASE_URL=https://api.seugym.com.br

# ─── Pagamentos ──────────────────────────────────────────────
# Escolha um: mock | mercadopago | pagarme | stripe
PAYMENT_GATEWAY=mock

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Pagar.me v5
PAGARME_SECRET_KEY=
PAGARME_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── E-mail ───────────────────────────────────────────────────
# Escolha um: console | smtp | sendgrid
EMAIL_PROVIDER=console

# SMTP (Gmail, AWS SES, etc.)
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM=noreply@seugym.com.br
EMAIL_FROM_NAME=GymSystem

# SendGrid
SENDGRID_API_KEY=

# ─── Check-in ────────────────────────────────────────────────
CHECKIN_SECRET=troque-por-um-segredo-forte

# Parceiros de check-in. Os dois funcionam juntos, nao sao exclusivos.
# mode=mock nao chama o parceiro — use ate ter as credenciais.

# Segredo embutido na URL do webhook da TotalPass. Eles nao assinam a chamada,
# entao e ele que impede alguem de criar entradas conhecendo a URL. TROQUE.
CHECKIN_WEBHOOK_SECRET=troque-por-um-segredo-forte

# IMPORTANTE: aqui ficam so as credenciais DA INTEGRADORA (a Crivo), que valem
# para todas as academias da instalacao. As credenciais de CADA ACADEMIA - o
# Gym ID do Wellhub e a place_api_key da TotalPass - sao cadastradas no painel,
# em Parceiros, e ficam no banco por tenant. Nao coloque nada disso aqui: uma
# credencial de unidade em variavel global faria a segunda academia ter as
# visitas creditadas para a primeira, no parceiro.

# ── Wellhub (antigo Gympass) — Access Control API ────────────
# A academia CONSULTA: o aluno faz check-in no app e nos validamos o
# gympass_id dele (cadastrado em Parceiros > vinculo).
# Credencial da integradora: bearer token estatico, pedido ao time comercial do
# Wellhub. Ele cobre varias unidades; o header X-Gym-Id escolhe qual.
# Sandbox: https://apitesting.partners.gympass.com/access/v1
# Doc: https://developers.wellhub.com/product/access-control-api/1.0/endpoints
WELLHUB_MODE=mock
WELLHUB_BASE_URL=https://api.partners.gympass.com/access/v1
WELLHUB_TOKEN=
# (o Gym ID de cada academia vai no painel, nao aqui)

# ── TotalPass ────────────────────────────────────────────────
# O parceiro AVISA: eles chamam nossa URL quando o aluno faz check-in, e nos
# confirmamos no link recebido (prazo de 90 min).
# Credencial da integradora: partner_api_key, pedida em
# tp.integracoes@totalpass.com.br. A documentacao deles e explicita: essa chave
# "nunca deve ser solicitada aos seus clientes".
# Doc: https://dev.totalpass.com/docs/
TOTALPASS_MODE=mock
TOTALPASS_AUTH_URL=https://booking-api.totalpass.com/partner/auth
TOTALPASS_WEBHOOK_URL=https://booking-api.totalpass.com/partner/webhook
TOTALPASS_PARTNER_API_KEY=
# (a place_api_key de cada academia vai no painel, nao aqui)

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200,https://app.seugym.com.br
